# === MODEL ARCHITECTURE ===
MODEL_NUM_PITCHES=128
MODEL_NUM_DURATIONS=128
MODEL_NUM_VELOCITIES=128
MODEL_NUM_INSTRUMENTS=128
MODEL_STYLE_CLASSES=2
MODEL_EMBED_DIM=256
MODEL_CONTROL_DIM=128
MODEL_HIDDEN_DIM=512
MODEL_DROPOUT=0.3
MODEL_DEVICE=auto

# Sprint 3 — Positional awareness & memory optimizations
MODEL_USE_POSITION_ENCODING=false
MODEL_NUM_POSITIONS=64
MODEL_USE_CHECKPOINTING=false
MODEL_USE_TORCH_COMPILE=false

# Sprint 4 — Deep architecture upgrades
MODEL_USE_CROSS_ATTENTION=false
MODEL_USE_INSTR_ATTN_POOLING=false
MODEL_USE_TOKEN_FUSION=false

# === TRAINING ===
TRAIN_SEQ_LEN=128
TRAIN_BATCH_SIZE=32
TRAIN_NUM_EPOCHS=30
TRAIN_LR=0.001
TRAIN_VAL_SPLIT=0.2
TRAIN_PATIENCE=7
TRAIN_TOKEN_PATH=data/encoded/encoded_tokens.pkl
TRAIN_OUTPUT_DIR=models
TRAIN_LOG_DIR=runs/hlstm

# Sprint 1 — Performance upgrades
TRAIN_USE_AMP=true
TRAIN_NUM_WORKERS=2
TRAIN_PIN_MEMORY=true
TRAIN_LOSS_WEIGHTS=1.0,1.0,1.0,1.0
TRAIN_LR_SCHEDULER=plateau
TRAIN_LR_PATIENCE=3
TRAIN_LR_MIN=1e-6
TRAIN_GRAD_CLIP_NORM=0.0

# === DATA (PREPROCESSING) ===
DATA_DIR=/path/to/dataset
DATA_ENCODED_PATH=data/encoded/encoded_tokens.pkl
DATA_SUB_DIRS=classical,contemporary
DATA_MIN_FILES_PER_CLASS=25
DATA_ENABLE_AUGMENTATION=false
DATA_USE_FIXED_BINS=false
DATA_CLUSTER_STYLES=false
DATA_CLUSTER_N_CLUSTERS=2

# === RAY DISTRIBUTED TRAINING ===
RAY_ENABLED=false
RAY_NUM_WORKERS=1
RAY_USE_GPU=false
RAY_STORAGE_PATH=/tmp/ray_results

# === GENERATION ===
GEN_PROMPT_FILE=test/prompt.mid
GEN_PRESET=gentle
GEN_NUM_SAMPLES=3
GEN_STYLE=1
GEN_INSTRUMENTS=40,41,42,43
GEN_NUM_STEPS=200
GEN_TEMPERATURE=0.7
GEN_TOP_K=40
GEN_TOP_P=0.9
GEN_NOTES_PER_CHORD=3
GEN_OUTPUT_DIR=output
